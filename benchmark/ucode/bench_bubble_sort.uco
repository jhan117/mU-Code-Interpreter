% int main() {
%   int a[1000];
%   int n = 1000;
%   int i = 0, j;
%
%   // input
%   while (i < n) {
      a[i] = n - i;
%     i++;
%   }
%
%   // bubble sort
%   for (i = 0; i < n - 1; i++) {
%     for (j = 0; j < n - 1 - i; j++) {
%       if (a[j] > a[j+1]) {
%         int temp = a[j];
%         a[j] = a[j+1];
%         a[j+1] = temp;
%       }
%     }
%   }
% }

% 프로그램 시작
           bgn 0
           ldp
           call main
           end

% main
main       proc 20

% i, j, n, temp, a[5]
           sym 2 0 1
           sym 2 1 1
           sym 2 2 1
           sym 2 3 1
           sym 2 4 1000

% n = 5
           ldc 1000
           str 2 2

% i = 0
           ldc 0
           str 2 0

% 입력 5개
$$INPUT    nop
           lod 2 0
           lod 2 2
           ge
           tjp $$END_INP

           lda 2 4
           lod 2 0
           sub
           lod 2 2
           lod 2 0
           sub
           sti

           lod 2 0
           ldc 1
           add
           str 2 0
           ujp $$INPUT

$$END_INP  nop

% bubble sort
           ldc 0
           str 2 0

$$I        nop
           lod 2 0
           lod 2 2
           ldc 1
           sub
           ge
           tjp $$END_SORT

           ldc 0
           str 2 1

$$J        nop
           lod 2 1
           lod 2 2
           ldc 1
           sub
           lod 2 0
           sub
           ge
           tjp $$NEXT_I

% if (a[j] > a[j+1])
           lda 2 4
           lod 2 1
           sub
           ldi
           lda 2 4
           lod 2 1
           ldc 1
           add
           sub
           ldi
           gt
           fjp $$NO_SWAP

% temp = a[j]
           lda 2 4
           lod 2 1
           sub
           ldi
           str 2 3

% a[j] = a[j+1]
           lda 2 4
           lod 2 1
           sub
           lda 2 4
           lod 2 1
           ldc 1
           add
           sub
           ldi
           sti

% a[j+1] = temp
           lda 2 4
           lod 2 1
           ldc 1
           add
           sub
           lod 2 3
           sti

$$NO_SWAP  nop
           lod 2 1
           ldc 1
           add
           str 2 1
           ujp $$J

$$NEXT_I   nop
           lod 2 0
           ldc 1
           add
           str 2 0
           ujp $$I

$$END_SORT nop
           ret
