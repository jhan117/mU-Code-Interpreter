% int fib(int n) {
%   if (n <= 1) return n;
%   return fib(n-1) + fib(n-2);
% }
%
% int main() {
%   int n;
%   read(&n);
%   write(fib(n));
%   return 0;
% }

% 프로그램 시작
% 전역변수 공간을 늘리기 위해 bgn 55000 사용
           bgn 55000
           sym 1 0 55000
           ldp
           call main
           end

% main
main       proc 1
% n
           sym 2 0 1

% read n
           ldp
           lda 2 0
           push
           call read

% fib(n)
           ldp
           lod 2 0
           push
           call fib

% print result
           ldp
           push
           call write
           ret

% fib 함수
fib        proc 501

% n
           sym 3 0 1
% 함수 프레임을 늘리기 위한 더미
           sym 3 1 500

% if (n <= 1) return n;
           lod 3 0
           ldc 1
           le
           tjp $$LODR

% fib(n-1)
$$RECUR    nop
           lod 3 0
           ldc 1
           sub
           ldp
           push
           call fib

% fib(n-2)
           lod 3 0
           ldc 2
           sub
           ldp
           push
           call fib

           add
           ujp $$RET

$$LODR     lod 3 0
$$RET      ret
