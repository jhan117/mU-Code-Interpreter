           bgn 0
           ldp
           call main
           end
main       proc 10
           sym 2 0 1
           sym 2 1 1
           sym 2 2 1
           ldp
           lda 2 0
           push
           call read
           ldp
           lda 2 1
           push
           call read
$$LOOP     nop
           lod 2 1
           ldc 0
           eq
           tjp $$END
           lod 2 0
           lod 2 1
           mod
           str 2 2
           lod 2 1
           str 2 0
           lod 2 2
           str 2 1
           ujp $$LOOP
           
$$END      nop
           ldp
           lod 2 0
           push
           call write

           ret